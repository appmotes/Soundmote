{
  "id": "pad-warm",
  "name": "Warm pad",
  "family": "pads",
  "moods": ["warm", "calm", "cosy"],
  "colour": "#8E6CC0",
  "character": "Wide, soft synth strings on D minor, the filter opening and closing slowly",
  "room": 0.1,
  "trim": 0.214,
  "glide": 0.3,
  "signals": [ { "name": "slow", "walk": 9 }, { "name": "flutter", "walk": 0.8 } ],
  "parts": [
    { "type": "sample", "files": ["pad-warm"], "fade": 4, "change": 40,
      "tune": "pow(2, waver * (40 * slow + 10 * flutter) / 1200)",
      "filters": [ { "type": "lowpass", "freq": "800 + 17200 * amount", "q": 0.6 } ],
      "gain": "amount^0.8" }
  ]
}
