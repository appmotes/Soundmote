{
  "id": "pad-strings",
  "name": "String pad",
  "family": "pads",
  "moods": ["warm", "calm"],
  "colour": "#8A70A0",
  "character": "A slow, warm string section held on D minor",
  "room": 0.1,
  "trim": 0.318,
