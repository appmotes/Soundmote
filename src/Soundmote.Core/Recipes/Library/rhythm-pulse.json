{
  "id": "rhythm-pulse",
  "name": "Soft pulse",
  "family": "rhythm",
  "moods": ["calm", "warm"],
  "colour": "#B85070",
  "character": "A deep, soft beat to breathe with, more felt than heard",
  "room": 0.2,
  "trim": 0.349,
  "glide": 0.3,
  "parts": [
