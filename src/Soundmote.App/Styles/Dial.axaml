<!-- Brushes for the dial, the flat curve, badges and thumbnails from the ground (D4, D8, D12). Ring colours come from the sounds. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="urn:Soundmote.App.Controls">
    <Style Selector="c|Dial">
        <Setter Property="FaceBrush" Value="{DynamicResource Brush.Bg.Panel}" />
        <Setter Property="GuideBrush" Value="{DynamicResource Brush.Dial.Guide}" />
        <Setter Property="TickBrush" Value="{DynamicResource Brush.Dial.Tick}" />
        <Setter Property="HandBrush" Value="{DynamicResource Brush.Ink.Primary}" />
        <Setter Property="TipBrush" Value="{DynamicResource Brush.Dial.Tip}" />
        <Setter Property="LabelBrush" Value="{DynamicResource Brush.Ink.Secondary}" />
        <Setter Property="RingShade" Value="{DynamicResource Ring.Shade}" />
    </Style>
    <Style Selector="c|CurveEditor">
        <Setter Property="GridBrush" Value="{DynamicResource Brush.Bg.Current}" />
        <Setter Property="InkBrush" Value="{DynamicResource Brush.Ink.Primary}" />
        <Setter Property="FaceBrush" Value="{DynamicResource Brush.Bg.Panel}" />
        <Setter Property="PlayheadBrush" Value="{DynamicResource Brush.Dial.Tip}" />
        <Setter Property="LabelBrush" Value="{DynamicResource Brush.Ink.Secondary}" />
        <Setter Property="RingShade" Value="{DynamicResource Ring.Shade}" />
    </Style>
    <Style Selector="c|SoundBadge">
        <Setter Property="RingShade" Value="{DynamicResource Ring.Shade}" />
    </Style>
    <Style Selector="c|PlaceMeter">
        <Setter Property="GuideBrush" Value="{DynamicResource Brush.Bg.Track}" />
        <Setter Property="RingShade" Value="{DynamicResource Ring.Shade}" />
    </Style>
    <Style Selector="c|SceneThumb">
        <Setter Property="GuideBrush" Value="{DynamicResource Brush.Dial.Guide}" />
        <Setter Property="HandBrush" Value="{DynamicResource Brush.Ink.Primary}" />
        <Setter Property="RingShade" Value="{DynamicResource Ring.Shade}" />
    </Style>
</Styles>
