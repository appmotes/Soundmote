<!-- Theme-neutral tokens (D1). Read with StaticResource. Colour lives in Themes/*.axaml. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Type roles -->
    <x:Double x:Key="Text.Title.Size">20</x:Double>
    <x:Double x:Key="Text.Row.Size">13</x:Double>
    <x:Double x:Key="Text.Meta.Size">11.5</x:Double>
    <x:Double x:Key="Text.Brand.Size">14</x:Double>
    <x:Double x:Key="Text.Clock.Size">40</x:Double>
    <x:Double x:Key="Text.Dock.Size">15</x:Double>
    <x:Double x:Key="Text.Segment.Size">12.5</x:Double>

    <!-- Layout (D2) -->
    <x:Double x:Key="Size.TitleBar.Height">52</x:Double>
    <x:Double x:Key="Size.Panel.Left">268</x:Double>
    <x:Double x:Key="Size.Panel.Right">300</x:Double>
    <x:Double x:Key="Size.Panel.Add">440</x:Double>
    <x:Double x:Key="Size.Dock.Height">62</x:Double>
    <x:Double x:Key="Size.Dock.Width">640</x:Double>
    <x:Double x:Key="Size.Button.Play">44</x:Double>
    <x:Double x:Key="Size.Swatch">10</x:Double>
    <x:Double x:Key="Size.Volume.Width">110</x:Double>
    <Thickness x:Key="Thickness.Window.Content">32,0,32,24</Thickness>
    <Thickness x:Key="Thickness.Panel">18</Thickness>
    <Thickness x:Key="Thickness.PanelList">10</Thickness>
    <Thickness x:Key="Thickness.Row">10,9</Thickness>
    <Thickness x:Key="Thickness.Dock">9,0,14,0</Thickness>

    <!-- Bedside (D17): the same on every ground, nearly black, nothing bright by the bed -->
    <SolidColorBrush x:Key="Brush.Bedside.Ground" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.Bedside.Ink" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="Brush.Bedside.Faint" Color="#1FFFFFFF" />
    <x:Double x:Key="Text.Bedside.Size">72</x:Double>

    <!-- Corners -->
    <CornerRadius x:Key="Radius.Panel">18</CornerRadius>
    <CornerRadius x:Key="Radius.Row">10</CornerRadius>
    <CornerRadius x:Key="Radius.Dock">31</CornerRadius>
    <CornerRadius x:Key="Radius.Segment">16</CornerRadius>
</ResourceDictionary>
